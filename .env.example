# Токен бота от @BotFather
TELEGRAM_TOKEN=

# AI-провайдер (build.nvidia.com, OpenAI-совместимый API).
# Ключ выдаётся на build.nvidia.com и выглядит как nvapi-...
NVMAPI_KEY=
NVMAPI_BASE_URL=https://integrate.api.nvidia.com/v1
NVMAPI_MODEL=meta/llama-3.1-8b-instruct
NVMAPI_TIMEOUT=30

# Сколько бесплатных AI-запросов в сутки без премиума
FREE_DAILY_QUOTA=10

# Канал, на который бот требует подписку (пусто — проверка выключена)
REQUIRED_CHANNEL=@minigamesbottgk

# Mini App: публичный адрес и локальный порт
WEBAPP_URL=https://slu1.heavencloud.in:2673
WEBAPP_PORT=2673
WEBAPP_SSL_CERT=
WEBAPP_SSL_KEY=

# Администраторы (id через запятую)
SUPPORT_ADMIN_IDS=
BOT_ADMIN_IDS=

# Кастомные эмодзи: 0 — выключить подстановку,
# порог entity на сообщение, число отказов подряд до отключения
NEWS_EMOJI_ENABLED=1
NEWS_EMOJI_MAX_PER_MESSAGE=50
NEWS_EMOJI_FAILURE_STREAK=10
