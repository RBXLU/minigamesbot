# Токен
TELEGRAM_TOKEN=

# ии провайдер
NVMAPI_KEY=
NVMAPI_BASE_URL=https://integrate.api.nvidia.com/v1
NVMAPI_MODEL=meta/llama-3.1-8b-instruct
NVMAPI_TIMEOUT=30

# Сколько бесплатных AI-запросов в сутки без премиума
FREE_DAILY_QUOTA=10

# Канал, на который бот требует подписку (пусто — проверка выключена)
REQUIRED_CHANNEL=@minigamesbottgk

# Mini App (0 — выключить)
WEBAPP_ENABLED=1
WEBAPP_URL=https://
WEBAPP_PORT=
WEBAPP_SSL_CERT=
WEBAPP_SSL_KEY=

# Администраторы (id через запятую)
SUPPORT_ADMIN_IDS=
BOT_ADMIN_IDS=

# Кастомные эмодзи
NEWS_EMOJI_ENABLED=1
NEWS_EMOJI_MAX_PER_MESSAGE=50
NEWS_EMOJI_FAILURE_STREAK=10

# 1 — при старте замерить, с какого размера запросы к Telegram обрываются
NET_DIAGNOSTIC=0

# Реферальная система
REFERRAL_REWARD=100
REFERRAL_WELCOME_BONUS=50
REFERRAL_MIN_GAMES=3
REFERRAL_MIN_DAYS=2
REFERRAL_DAILY_LIMIT=10

# Ивенты (последний день включительно). EVENT_FORCE=halloween включает ивент вне дат — для проверки
HALLOWEEN_START=2026-10-25
HALLOWEEN_END=2026-11-02
ANNIVERSARY_START=2026-11-13
ANNIVERSARY_END=2026-11-19
EVENT_FORCE=
PUMPKINS_PER_PLAY=1
PUMPKINS_PER_WIN=2
PUMPKINS_DAILY_GAME_CAP=60
PUMPKIN_HUNT_CHANCE=0.04
PUMPKIN_HUNT_COOLDOWN=1200
PUMPKIN_HUNT_MIN=3
PUMPKIN_HUNT_MAX=7
BROADCAST_RATE=25
SEASON_START=2026-11-13
SEASON_END=2027-01-31
SEASON_XP_PER_LEVEL=150
SEASON_XP_PER_PLAY=5
SEASON_XP_PER_WIN=10
SEASON_DAILY_GAME_XP_CAP=250
